# ==============================================================================
# Lordera Gateway — Dockerfile (Groq API backend, v3.0.0)
# ==============================================================================
# Minimal image: only the Gateway (FastAPI) is built here.
# No Akash CLI, no provider-services, no GPU drivers, no blockchain libs.
# ==============================================================================

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120

WORKDIR /app

# 1- Minimal OS tools (curl for HEALTHCHECK only)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2- Install Python deps from requirements.txt (single source of truth)
COPY requirements.txt .
RUN pip3 install --retries 10 --timeout 120 -r requirements.txt

# 3- Copy application code
COPY . .

# 4- Runtime config
ARG SERVICE=gateway_service
ARG PORT=8000
ENV SERVICE=${SERVICE} PORT=${PORT}

EXPOSE ${PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# 5- Run uvicorn (exec for clean signal handling)
CMD ["sh", "-c", "exec python3 -m uvicorn ${SERVICE}:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]